rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if the current user is an Admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'vishwajeetaman15@gmail.com' ||
        request.auth.token.email == 'Vishwajeetaman15@gmail.com' ||
        request.auth.token.email == 'vishwajeetsrk@gmail.com' ||
        request.auth.token.email == 'Vishwajeetsrk@gmail.com' ||
        request.auth.token.email == 'viswajeetsrk@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('inAdmin', false) == true
        ))
      );
    }

    // Helper: Check if the current user is a Moderator
    function isModerator() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'moderator'
        ))
      );
    }

    // --- COLLECTION: USERS ---
    match /users/{userId} {
      allow read: if isAuthenticated(); // Highly secure, allows verified users to read profiles (standard for social networking applications)
      
      // Only allow users to create their own documents
      allow create: if isOwner(userId);
      
      // Hardened security: prevents recursive lookups and locks
      allow update: if 
        // Scenario 1: User is the owner - bypasses the recursive isAdmin() database read to prevent evaluation timeouts
        (isOwner(userId) && 
         // CRITICAL: Prevent standard users from escalating their privilege via the client SDK
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) 
        || 
        // Scenario 2: Administrator writing to another user's record via dashboard
        (request.auth.uid != userId && isAdmin());
        
      allow delete: if isOwner(userId) || isAdmin();

      // --- SUB-COLLECTION: ARTIFACTS ---
      match /artifacts/{artifactId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- COLLECTION: JOBS ---
    match /jobs/{jobId} {
      allow read: if true; // Publicly accessible
      allow write: if isAdmin() || isModerator();
    }

    // --- COLLECTION: MEETINGS (ACTIVITIES) ---
    match /meetings/{meetingId} {
      allow read: if true; // Publicly accessible
      allow write: if isAdmin() || isModerator();
    }

    // --- COLLECTION: RESOURCES ---
    match /resources/{resourceId} {
      allow read: if true; // Publicly accessible
      allow write: if isAdmin() || isModerator();
    }

    // --- COLLECTION: MENTORS ---
    match /mentors/{mentorId} {
      allow read: if true; // Publicly accessible
      allow write: if isAdmin() || isModerator();
    }

    // --- COLLECTION: APPLICATIONS (JOB TRACKER) ---
    match /applications/{appId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- COLLECTION: AUDIT LOGS ---
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Backward-compatible legacy admin log collection name
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // --- COLLECTION: SCHOLARSHIP REQUESTS ---
    match /scholarship_requests/{requestId} {
      allow read, update, delete: if isAdmin() || isModerator();
      allow create: if isAuthenticated();
    }

    // --- COLLECTION: COMMUNITY POSTS ---
    match /community_posts/{postId} {
      allow read: if isAuthenticated() || true; // Publicly accessible for educational sharing
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin() || isModerator());
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin() || isModerator());

      // --- SUB-COLLECTION: COMMENTS ---
      match /comments/{commentId} {
        allow read: if isAuthenticated() || true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin() || isModerator());
      }
    }

    // --- COLLECTION: REPORTS ---
    match /reports/{reportId} {
      allow read: if isAdmin() || isModerator();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isModerator();
    }

    // --- COLLECTION: CRISIS ALERTS ---
    match /crisis_alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() || true; // Server-side admin SDK bypasses rules, but allow client backup logs
      allow update, delete: if isAdmin();
    }

    // --- COLLECTION: MODERATION REPORTS ---
    match /moderation_reports/{reportId} {
      allow read: if isAdmin() || isModerator();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isModerator();
    }

    // --- COLLECTION: VERIFICATION DOCUMENTS ---
    match /verification_documents/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- COLLECTION: AI CALLS (MONITORING) ---
    match /ai_calls/{callId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() || true; // Server logs AI calls
      allow update, delete: if isAdmin();
    }

    // --- COLLECTION: SCHOLARSHIPS ---
    match /scholarships/{scholarshipId} {
      allow read: if true; // Publicly accessible
      allow create, update, delete: if isAdmin() || isModerator();
    }

    // --- COLLECTION: JOB SCAM ANALYSES ---
    match /job_scam_analyses/{analysisId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() || true; // Server logs
      allow update, delete: if isAdmin();
    }

    // --- COLLECTION: FEATURE FLAGS ---
    match /featureFlags/{flagId} {
      allow read: if true; // Public feature flags for client UI
      allow write: if isAdmin();
    }


  }
}
