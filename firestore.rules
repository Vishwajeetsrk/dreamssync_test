rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if the current user is an Admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    // Helper: Check if the current user is a Moderator
    function isModerator() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'moderator';
    }

    // --- COLLECTION: USERS ---
    match /users/{userId} {
      allow read: if isAuthenticated(); // Highly secure, allows verified users to read profiles (standard for social networking applications)
      
      // Only allow users to create their own documents
      allow create: if isOwner(userId);
      
      // Hardened security: prevents recursive lookups and locks
      allow update: if 
        // Scenario 1: User is the owner - bypasses the recursive isAdmin() database read to prevent evaluation timeouts
        (isOwner(userId) && 
         // CRITICAL: Prevent standard users from escalating their privilege via the client SDK
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) 
        || 
        // Scenario 2: Administrator writing to another user's record via dashboard
        (request.auth.uid != userId && isAdmin());
        
      allow delete: if isOwner(userId) || isAdmin();

      // --- SUB-COLLECTION: ARTIFACTS ---
      match /artifacts/{artifactId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- COLLECTION: JOBS ---
    match /jobs/{jobId} {
      allow read: if true; // Publicly accessible
      allow write: if isAdmin() || isModerator();
    }

    // --- COLLECTION: MEETINGS (ACTIVITIES) ---
    match /meetings/{meetingId} {
      allow read: if true; // Publicly accessible
      allow write: if isAdmin() || isModerator();
    }

    // --- COLLECTION: RESOURCES ---
    match /resources/{resourceId} {
      allow read: if true; // Publicly accessible
      allow write: if isAdmin() || isModerator();
    }

    // --- COLLECTION: APPLICATIONS (JOB TRACKER) ---
    match /applications/{appId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- COLLECTION: ADMIN LOGS ---
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

  }
}
